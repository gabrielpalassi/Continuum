{
  "name": "continuum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "all": "bun run remove && bun run build && bun run setup",
    "build": "bun run fmt-lint && bash scripts/build.sh",
    "setup": "bash scripts/install.sh",
    "remove": "gnome-extensions uninstall continuum@gabrielpalassi.github.io 2>/dev/null || true",
    "start": "env MUTTER_DEBUG_DUMMY_MODE_SPECS=1256x768 dbus-run-session -- gnome-shell --nested",
    "start:multimonitor": "env MUTTER_DEBUG_NUM_DUMMY_MONITORS=2 dbus-run-session -- gnome-shell --nested",
    "test": "bun test ./test/*.test.js",
    "test:integration": "bash scripts/test-integration.sh",
    "test:all": "bun run test && bun run test:integration",
    "fmt": "bun fmt --no-script --check .",
    "fmt:fix": "bun fmt --no-script .",
    "lint": "bun run --bun eslint .",
    "lint:fix": "bun run --bun eslint . --fix",
    "fmt-lint": "bun run fmt && bun run lint",
    "fmt-lint:fix": "bun run fmt:fix && bun run lint:fix"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "eslint-plugin-jsdoc": "^50.6.9"
  },
  "packageManager": "bun@1.4.4"
}
